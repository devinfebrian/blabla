# Project id and dataset are public constants in sanity/env.ts — only the token is secret.
SANITY_API_TOKEN=your-editor-token

# Shared secret for the Sanity publish webhook -> POST /api/revalidate
SANITY_REVALIDATE_SECRET=your-revalidate-secret

# Neon Postgres (orders + stock). `neon link` / `neon env pull` write this for you; it is
# server-only, so never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Single password for the /admin panel. The session cookie is an HMAC of this value.
ADMIN_PASSWORD=change-me
